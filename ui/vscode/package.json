{
  "name": "jkb-explorer",
  "displayName": "jkb Explorer",
  "description": "Browse and edit your jkb knowledge base as a tree, backed entirely by the jkb CLI.",
  "version": "0.1.0",
  "private": true,
  "publisher": "jkb",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "jkb", "title": "jkb", "icon": "media/jkb.svg" }
      ]
    },
    "views": {
      "jkb": [
        { "id": "jkb.explorer", "name": "Explorer" }
      ]
    },
    "commands": [
      { "command": "jkb.refresh", "title": "jkb: Refresh Explorer", "icon": "$(refresh)" },
      { "command": "jkb.toggleTerminal", "title": "jkb: Show/Hide Completed Tasks", "icon": "$(eye)" },
      { "command": "jkb.search", "title": "jkb: Search", "icon": "$(search)" },
      { "command": "jkb.openDetails", "title": "jkb: Open Details" },
      { "command": "jkb.workTask", "title": "jkb: Work this task with Claude", "icon": "$(sparkle)" },
      { "command": "jkb.landTask", "title": "jkb: Land this task", "icon": "$(git-merge)" }
    ],
    "menus": {
      "view/title": [
        { "command": "jkb.search", "when": "view == jkb.explorer", "group": "navigation@1" },
        { "command": "jkb.refresh", "when": "view == jkb.explorer", "group": "navigation@2" },
        { "command": "jkb.toggleTerminal", "when": "view == jkb.explorer", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "jkb.workTask", "when": "view == jkb.explorer && viewItem == task", "group": "inline" },
        { "command": "jkb.workTask", "when": "view == jkb.explorer && viewItem == task", "group": "jkb@1" },
        { "command": "jkb.landTask", "when": "view == jkb.explorer && viewItem == task", "group": "jkb@2" }
      ]
    },
    "configuration": {
      "title": "jkb",
      "properties": {
        "jkb.cliPath": {
          "type": "string",
          "default": "jkb",
          "description": "Path to the jkb binary (on PATH by default)."
        },
        "jkb.dbPath": {
          "type": "string",
          "default": "",
          "description": "Path to the jkb database (blank uses $JKB_DB or ~/.jkb/jkb.db)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jkb/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
