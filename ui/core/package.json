{
  "name": "@jkb/core",
  "version": "0.1.0",
  "private": true,
  "description": "Portable jkb UI core: models, the JkbClient transport interface, the node-kind registry, and detail rendering. No vscode, no Node APIs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
