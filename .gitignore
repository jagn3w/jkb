# Ignore local Claude config, but commit the bundled slash commands + workflows so they
# ship across machines (and the jkb binary can embed them at build time).
.claude/*
!.claude/commands/
!.claude/workflows/
!.claude/hooks/
!.claude/settings.json
openspec/
.codereviews/
.backlog/

# Rust build artifacts
/target
**/*.rs.bk

# jkb local databases and backups (tests use temp dirs; never commit a live DB)
*.db
*.db-wal
*.db-shm

# /task-swarm integration + per-task git worktrees
.swarm/

# `jkb task work` sessions: per-task git worktrees, the land target's checkout, the land
# lock. Committed here as well as written to .git/info/exclude, so a fresh clone of jkb
# never sees them even before the first session runs.
.jkb/