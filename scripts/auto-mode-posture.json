{
  "require": {
    "permissions": {
      "defaultMode": "auto",
      "disableBypassPermissionsMode": "disable",
      "ask": [
        "WebFetch"
      ],
      "deny": [
        "Read(~/.ssh/**)",
        "Read(~/.aws/**)",
        "Read(~/.gnupg/**)",
        "Read(~/.config/gh/**)",
        "Read(~/.kube/**)",
        "Read(~/.docker/config.json)",
        "Read(~/.netrc)",
        "Read(~/.npmrc)",
        "Read(~/.pypirc)",
        "Read(~/.cargo/credentials.toml)",
        "Read(~/.claude/.credentials.json)",
        "Read(~/.claude-state/.credentials.json)",
        "Read(~/.claude-state/claude.json)",
        "Read(~/.claude.json)",
        "Read(~/.local/share/keyrings/**)",
        "Read(~/.pki/**)",
        "Read(~/.config/gcloud/**)",
        "Read(~/.git-credentials)",
        "Read(~/.config/git/credentials)",
        "Read(~/.cargo/credentials)",
        "Read(~/.config/gh/hosts.yml)",
        "Read(~/Library/Keychains/**)",
        "Read(~/Library/Messages/**)",
        "Read(~/Library/Mail/**)",
        "Read(~/Documents/**)",
        "Read(~/Desktop/**)",
        "Read(~/Downloads/**)",
        "Edit(~/.claude/settings.json)",
        "Edit(~/.claude/settings.local.json)",
        "Edit(~/.claude/plugins/**)"
      ]
    },
    "sandbox": {
      "enabled": true,
      "failIfUnavailable": true,
      "allowUnsandboxedCommands": false,
      "autoAllowBashIfSandboxed": true,
      "allowAppleEvents": false,
      "enableWeakerNestedSandbox": false,
      "enableWeakerNetworkIsolation": false,
      "network": {
        "strictAllowlist": true,
        "allowLocalBinding": true,
        "allowAllUnixSockets": false,
        "allowedDomains": [
          "localhost",
          "127.0.0.1",
          "api.anthropic.com",
          "github.com",
          "api.github.com",
          "codeload.github.com",
          "*.githubusercontent.com",
          "objects.githubusercontent.com",
          "raw.githubusercontent.com",
          "crates.io",
          "index.crates.io",
          "static.crates.io",
          "*.rust-lang.org",
          "static.rust-lang.org",
          "registry.npmjs.org",
          "get.pnpm.io",
          "registry.ollama.ai"
        ]
      },
      "filesystem": {
        "disabled": false,
        "denyRead": [
          "~",
          "/Volumes",
          "/media",
          "/mnt",
          "/run/media"
        ],
        "allowRead": [
          "~/repos",
          "~/.jkb",
          "~/.cargo",
          "~/.rustup",
          "~/.local/bin",
          "~/.local/share/pnpm",
          "~/Library/pnpm",
          "~/Library/Caches",
          "~/.local/share/claude",
          "~/.claude/settings.json",
          "~/.claude/settings.local.json",
          "~/.claude/skills",
          "~/.claude/plugins",
          "~/.claude/commands",
          "~/.gitconfig",
          "~/.gitignore_global",
          "~/.zshrc",
          "~/.zshenv",
          "~/.zprofile",
          "~/.profile",
          "~/.bashrc",
          "~/.bash_profile",
          "~/.cache",
          "~/.config/git",
          "~/.config/pnpm",
          "/private/tmp",
          "/var/folders",
          "/private/var/folders",
          "/tmp"
        ],
        "allowWrite": [
          "~/repos",
          "~/.jkb",
          "~/.cargo",
          "~/.rustup",
          "~/Library/Caches",
          "~/Library/pnpm",
          "~/.local/share/pnpm",
          "/tmp",
          "~/.cache",
          "/private/tmp",
          "/var/folders",
          "/private/var/folders"
        ]
      },
      "credentials": {
        "files": [
          {
            "path": "~/.ssh",
            "mode": "deny"
          },
          {
            "path": "~/.aws",
            "mode": "deny"
          },
          {
            "path": "~/.gnupg",
            "mode": "deny"
          },
          {
            "path": "~/.config/gh",
            "mode": "deny"
          },
          {
            "path": "~/.kube",
            "mode": "deny"
          },
          {
            "path": "~/.docker/config.json",
            "mode": "deny"
          },
          {
            "path": "~/.netrc",
            "mode": "deny"
          },
          {
            "path": "~/.npmrc",
            "mode": "deny"
          },
          {
            "path": "~/.pypirc",
            "mode": "deny"
          },
          {
            "path": "~/.cargo/credentials.toml",
            "mode": "deny"
          },
          {
            "path": "~/.claude/.credentials.json",
            "mode": "deny"
          },
          {
            "path": "~/.claude-state/.credentials.json",
            "mode": "deny"
          },
          {
            "path": "~/.claude-state/claude.json",
            "mode": "deny"
          },
          {
            "path": "~/.claude.json",
            "mode": "deny"
          },
          {
            "path": "~/Library/Keychains",
            "mode": "deny"
          },
          {
            "path": "~/.local/share/keyrings",
            "mode": "deny"
          },
          {
            "path": "~/.pki",
            "mode": "deny"
          },
          {
            "path": "~/.config/gcloud",
            "mode": "deny"
          },
          {
            "path": "~/.git-credentials",
            "mode": "deny"
          },
          {
            "path": "~/.config/git/credentials",
            "mode": "deny"
          },
          {
            "path": "~/.cargo/credentials",
            "mode": "deny"
          },
          {
            "path": "~/.config/gh/hosts.yml",
            "mode": "deny"
          }
        ]
      }
    }
  },
  "retire": {
    "permissions.deny": [
      "Write(~/.claude/settings.json)",
      "Write(~/.claude/settings.local.json)",
      "Write(~/.claude/plugins/**)"
    ]
  },
  "forbid": {
    "sandbox.excludedCommands": "commands excluded from the sandbox \u2014 a bypass list, must be empty",
    "permissions.additionalDirectories": "widens the in-process permission scope beyond the workspace"
  }
}
