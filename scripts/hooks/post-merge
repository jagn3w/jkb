#!/usr/bin/env bash
# Repo-local post-merge hook (design D34.5). Installed by scripts/setup.sh.
#
# Fires after any merge that changes the work tree — which is every `git pull` that brings
# something in. Two chores that were previously manual:
#
#   1. re-run setup.sh, so the installed `jkb` binary and the VS Code extension match what
#      was just pulled — but ONLY when the merge touched something setup.sh installs;
#   2. close tasks whose pull request has merged (`jkb task close-merged`).
#
# Never fails the merge. A hook that can break `git pull` is worse than the chore it
# replaces, so every step is best-effort and reports rather than exits non-zero.
set -uo pipefail

# A HOOK HONOURS THE ENVIRONMENT GIT HANDS IT, and every git call here is therefore bare.
#
# Git runs a hook with the cwd at the working tree it resolved. What it puts in the environment
# DEPENDS ON THE LAYOUT — measured on 2.51.1, all three:
#
#   ordinary checkout    GIT_DIR unset, GIT_WORK_TREE unset      (cwd alone is enough)
#   linked worktree      GIT_DIR=<repo>/.git/worktrees/<name>    (GIT_WORK_TREE unset)
#   GIT_WORK_TREE leaked GIT_DIR=<repo>/.git, GIT_WORK_TREE=.
#   --work-tree=T FLAG   GIT_DIR=D, GIT_WORK_TREE=.              BYTE-IDENTICAL to the row above
#   --separate-git-dir   GIT_DIR=<abs gitdir>                    (GIT_WORK_TREE unset)
#   submodule            GIT_DIR=<super>/.git/modules/<name>     (GIT_WORK_TREE unset)
#   GIT_COMMON_DIR set   passed through VERBATIM, and it disables core.worktree
#
# Two rows that are not layouts and matter anyway. `GIT_CONFIG_COUNT`/`GIT_CONFIG_PARAMETERS`
# reach a hook in ORDINARY pulls — this project's own dev container injects four `safe.directory`
# grants that way — so their presence is not an attack signature and nothing here may treat it as
# one. And the fourth row is why the round-23 remedy works: the flag spelling of the dotfiles
# alias, which is the canonical one, is indistinguishable from the exported spelling once git has
# chdir'd, so a guard keyed on `GIT_WORK_TREE` cannot tell a user's alias from a leak.
#
# So `GIT_DIR` is not always set — but wherever it IS set it names the repository the merge was
# about, and in the third row it is the ONLY pointer to it. Stripping it there is not a safety
# measure, it is losing the subject. (An earlier version of this comment stated the third row
# as though it were all three: one layout measured, three asserted.) A previous round stripped it and MEASURED the
# result: `ORIG_HEAD` stopped resolving, the `HEAD^..HEAD` fallback answered about the wrong
# repository, `changed` came back empty, and a pull that changed `crates/` printed "no
# build-affecting changes pulled" — the exact failure the strip was written to prevent, caused
# by the strip.
#
# Stripping cannot help in any case either, which is the other half of why it is gone:
# `--show-toplevel` answers the redirected tree with the variables set OR unset (with `GIT_DIR`
# set and `GIT_WORK_TREE` unset, git regards the CWD as the work-tree top, and git already
# chdir'd there). So the redirection is detected below rather than fought.

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$repo_root" ] || exit 0

# ...and the one thing the environment CAN get wrong is which checkout to build. With
# `GIT_WORK_TREE` exported — the standard bare-dotfiles shell recipe — the merge is about this
# repository while `--show-toplevel` names an unrelated one, and running THAT checkout's
# setup.sh is the harm the whole repository-selection rule exists to prevent: jkb runs inside
# other people's professional repositories and must not build them.
#
# Asked of git, not of the variables: whether the checkout at $repo_root belongs to the
# repository this merge was about. Best-effort, like everything here: a question git will not
# answer stops the hook rather than failing the merge.
#
# `pwd -P` on both sides because a symlink, a trailing slash and a `..` are three spellings of
# one directory — the rule `git_hooks_dir` needed in lib.sh, where literal equality DID produce
# a false alarm. It is LOAD-BEARING here too, and an earlier round of this comment said the
# opposite on a bad measurement, which is worth recording because the bad measurement looked
# fine. Nine layouts were tried and all of them entered the checkout with `git -C <path>` —
# which NORMALISES $PWD to the physical path before running the hook. That erased the one
# variable being tested, so removing `pwd -P` changed no answer and the comment concluded it
# was merely defensive.
#
# Enter the link the way a person does — `cd ~/repos/x && git pull` — and the hook gets the
# SYMLINK path in $PWD while `--show-toplevel` answers the physical one. Measured: without
# `pwd -P` the hook then prints "belongs to a different repository" and skips setup.sh and
# close-merged, permanently, for anyone whose checkout is reached through a link (`~/repos` a
# symlink, macOS `/tmp` -> `/private/tmp`). Pinned by case10l step 4, which now `cd`s in.
# `--git-common-dir` rather than `--path-format=absolute --git-common-dir`. `--path-format` is
# a much later addition than `--git-common-dir` (not verified here to a version, which is why it
# is avoided rather than relied on): on a git without it rev-parse exits non-zero, the hook
# would `exit 0`, and the D34 automation would be silently off for that user.
#
# A relative answer is anchored at the directory it was ASKED FROM, never at the cwd — the two
# differ here by construction, which is the whole point of the comparison.
common_of() {   # common_of [dir] — [dir] asks with the environment scrubbed; no arg asks as git
    local d="${1:-}" c                    # handed us. Prints an absolute, symlink-resolved path.
    if [ -n "$d" ]; then
        c="$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
             git -C "$d" rev-parse --git-common-dir 2>/dev/null)" || return 1
    else
        d="$PWD"
        c="$(git rev-parse --git-common-dir 2>/dev/null)" || return 1
    fi
    [ -n "$c" ] || return 1
    case "$c" in /*) ;; *) c="$d/$c" ;; esac
    [ -d "$c" ] || return 1
    (cd "$c" 2>/dev/null && pwd -P)
}
# honoured_read <key> [extra git config flags…] — set `$honoured_value` to the value git would
# HONOUR for <key>, and `$honoured_scope` to the flag needed to write one back into that scope.
#
# TWO GLOBALS, and no printing, because the answer is two facts. Written as "print the value,
# set the scope" it was called as `declared="$(honoured_read core.worktree)"` — a command
# SUBSTITUTION, so the scope was assigned in a subshell and discarded, and every remedy printed
# the scope-less form again. Caught immediately by the step that RUNS the remedy, which is the
# only reason the fix for the finding was not itself the finding.
#
# One reader for both keys, because they have the same rule and the rule is not obvious. Git
# honours `core.worktree` and `core.bare` from `$GIT_DIR/config`, and from
# `$GIT_DIR/config.worktree` when `$GIT_DIR/config` itself enables `extensions.worktreeConfig` —
# and a value in `config.worktree` OUTRANKS the local one. Measured on 2.51.1:
#
#     config.worktree: core.worktree = /old      rev-parse --show-toplevel -> /old
#     git --git-dir=D config core.worktree /new  rev-parse --show-toplevel -> /old   (!)
#     git --git-dir=D config --worktree … /new   rev-parse --show-toplevel -> /new
#
# That middle line was the printed remedy, so for anyone whose declaration lived in
# `config.worktree` the instruction did nothing, for ever, under a sentence claiming it
# "replaces that declaration". The same round that made such a declaration READABLE here is the
# one that made it reachable. `core.bare` behaves identically — a `config.worktree` `bare = true`
# survives a local `bare = false`, and the repository stays bare, so that remedy line is inert
# in the same layout.
#
# So reading and writing go through one function: whatever scope the answer CAME from is the
# scope the fix must go to. With no value anywhere, `$honoured_scope` is empty and a local write
# is right — measured too: extension on, `config.worktree` holding no `core.worktree`, a local
# declaration IS honoured.
#
# Degrades like the read it replaces: on a git without `--worktree` the first ask fails, the
# value is empty, and everything falls through to `--local` — which is what that git honours.
honoured_value=""
honoured_scope=""
honoured_read() {
    local key="$1"
    shift
    honoured_value=""
    honoured_scope=""
    if [ "${wtc:-}" = true ]; then
        honoured_value="$(git config --worktree "$@" "$key" 2>/dev/null)" || honoured_value=""
        if [ -n "$honoured_value" ]; then
            honoured_scope="--worktree"
            return 0
        fi
    fi
    honoured_value="$(git config --local "$@" "$key" 2>/dev/null)" || honoured_value=""
    return 0
}

hook_common="$(common_of "")" || exit 0
# THE VERDICT IS THREE-VALUED, AND THE ARM BELOW CAN REACH EXACTLY ONE OF ITS BRANCHES.
#
# This is the shape correction a design pass produced after three consecutive rounds of defects
# in the ~25 lines that follow. The two asks were never wrong; what oscillated was collapsing
# their THREE outcomes into two. `root_common="$(common_of "$repo_root")" || root_common=""`
# turned "could not establish" into a sentinel the comparison read as "a different repository",
# and the acceptance arm then existed to repair that collapse — spelled as an assignment to
# `root_common`, which made it an OVERRIDE of the comparison, able to rewrite any verdict at all.
#
# That is the machine that produced every round, and it explains why each locally-correct fix
# opened the opposite defect: with no third place to stand, every fix had to choose which side
# of one accept/refuse line to widen.
#
#   round 19  arm resolved the declaration against the HOOK'S CWD    false refusal
#   round 20  arm dropped the comparison, asked only "is it set?"    false ACCEPTANCE: a
#             (measured: `GIT_COMMON_DIR` makes git ignore the        GIT_COMMON_DIR leak ran
#             declaration while `git config` still reports it)        another checkout's setup.sh
#   round 21  arm restored the comparison + resolved per git-config  correct, but still an
#                                                                     override held off by a
#                                                                     list of predicates
#
# Measured across ten layouts: NO legitimate layout lands in "elsewhere", and NO harmful layout
# lands in "same". Every ambiguity this guard has ever had lives inside "unestablished". So:
#
#   THE ARM MAY PROMOTE `unestablished` TO `same`. IT MUST NEVER SEE, LET ALONE REWRITE,
#   AN ESTABLISHED ANSWER.
#
# Confined that way the invariant is structural rather than remembered — which is this repo's
# own rule ("a rule every call site must remember is the defect") applied to the guard itself.
# It also shrinks both failure modes at once: the worst a future arm bug can now do is accept a
# tree NO repository owns, instead of building a different repository's checkout, and the worst
# an over-narrow arm can do is an honest, remediable skip instead of a false permanent refusal.
if root_common="$(common_of "$repo_root")"; then
    if [ "$root_common" = "$hook_common" ]; then
        verdict=same
    else
        verdict=elsewhere
    fi
else
    verdict=unestablished

    # AND CHORE 2 IS OFF FROM HERE DOWN, including where this branch goes on to say `same`.
    # Set in the branch rather than in one of the arms below, because it is a property of the
    # branch: everything here is a tree that `git rev-parse` could not resolve to a repository
    # with the caller's selection scrubbed, and that is precisely what `jkb task close-merged`
    # does to find out which repository it is closing tasks for. See chore 2 for the measurement.
    skip_close=1

    # ...because an answer we could not obtain is not the answer "a different repository". A
    # checkout set up with `core.worktree` has NO `.git` entry of its own, so discovering from
    # `$repo_root` with the environment scrubbed fails. The repository being merged knows the
    # answer, though: `core.worktree` is IT DECLARING this working tree.
    #
    # READ FROM EXACTLY THE FILES GIT READS WHEN IT DECIDES THE SAME THING.
    #
    # That is the whole rule, and it is not a curated list of scopes — it is git's own honouring
    # set, measured to coincide. Git honours `core.worktree` for work-tree resolution from
    # `$GIT_DIR/config`, and from `$GIT_DIR/config.worktree` when `$GIT_DIR/config` ITSELF turns
    # on `extensions.worktreeConfig`. Nowhere else: not `--global`, not `--system`, not `-c`, not
    # `GIT_CONFIG_COUNT`/`GIT_CONFIG_PARAMETERS`, not through `[include]` — measured, all six.
    #
    # A bare `git config core.worktree` reads ALL of those. So the previous round's arm believed
    # a declaration git itself would not honour, and every one of those channels is the caller's:
    # measured end-to-end against a prey directory holding a marker `setup.sh`, `-c
    # core.worktree=`, `GIT_CONFIG_COUNT`/`KEY_0`/`VALUE_0`, `GIT_CONFIG_PARAMETERS`, a `--global`
    # declaration and `GIT_CONFIG_GLOBAL` ALL made this hook run setup.sh in a directory no
    # repository owns. Five for five, against the arm whose comment said it was reading "that
    # repository's config and not the caller's".
    #
    # The scoped read cannot be forged: measured, all six read back empty, and the only handles
    # that move the local scope — `GIT_DIR`, `GIT_COMMON_DIR` — move `hook_common` WITH it, so
    # the declaration always comes from the very repository the verdict is about. The caller
    # cannot split the two.
    #
    # NOT the walk `_hooks_path_read` does in lib.sh, and the difference is the rule rather than
    # an exception to it: git honours `core.hooksPath` from every stored scope, with precedence
    # and includes, so lib.sh must walk all four and skip only command scope. The keys differ in
    # WHERE git honours them, so the reads differ. A later round "harmonising" these two — adding
    # `--global` or `--includes` here for consistency — re-opens the forge; `case10l` pins it.
    #
    # `--worktree` is git 2.20, later than this file's 2.5 floor, and it DEGRADES CORRECTLY:
    # measured against a git shimmed to refuse it, the local-declaration layout still builds and
    # the `config.worktree` layout skips — which is what that old git honours too, since a git
    # predating the extension ignores `config.worktree` itself. The read mirrors the running git
    # at every age, which is why it is safe here and `--absolute-git-dir` was not.
    #
    # There is no `GIT_WORK_TREE` condition any more, and its removal is the point rather than a
    # simplification. It was written to stop the caller's word being taken for the repository's
    # — a job the scoped read now does completely — and measured, the only arm-reachable case it
    # blocked was "the caller redirected to exactly the tree this repository declares", which is
    # a CORRECT accept. What it actually did was make the printed remedy inert for everyone
    # whose alias sets the work tree, which is every user of the layout the refusal is written
    # for: `git --git-dir=D --work-tree=T` and `export GIT_WORK_TREE=T` are BYTE-IDENTICAL inside
    # the hook (git rewrites both to `GIT_WORK_TREE=.` after chdir'ing), so the user ran the
    # remedy, nothing changed, and the same refusal reprinted for ever with a sentence that had
    # become false. Every harmful `GIT_WORK_TREE` case lands in `elsewhere`, which the arm cannot
    # reach, or fails the equality below.
    wtc="$(git config --local --bool extensions.worktreeConfig 2>/dev/null)" || wtc=""
    honoured_read core.worktree
    declared="$honoured_value"
    # ...and WHERE it was honoured from, because the refusal below prints a command to change
    # it and a write to the wrong scope is silently ignored. See `honoured_read`. Captured HERE
    # rather than read at the print, because the `core.bare` read in the arm overwrites
    # `$honoured_scope` and is printed first.
    declared_scope="$honoured_scope"
    # Kept as read, because `$declared` is resolved to an absolute path below and the refusal
    # wants to show the operator the line that is actually in their config file.
    declared_raw="$declared"
    if [ -n "$declared" ]; then
        # `--git-dir` and absolutise it here, NOT `--absolute-git-dir` — the same reasoning this
        # file applies to `--path-format=absolute` sixty lines up. `--absolute-git-dir` is a much
        # later addition: on a git without it `gitdir` is empty, this arm can never fire, and a
        # `core.worktree` checkout is refused on EVERY pull.
        #
        # MEASURED, both forms, against a git shimmed to refuse `--absolute-git-dir`: the old
        # form printed "belongs to a different repository" for a checkout git resolves perfectly
        # well. The shim must be applied to a DIRECT run of this script — git prepends its own
        # `GIT_EXEC_PATH`, which holds a real `git`, before running a hook, so a PATH shim never
        # reaches one and a `git merge` run silently measures the unshimmed git and passes
        # either way. That false negative was observed first.
        #
        # The declaration is resolved as git-config(5) documents it: "absolute or relative to
        # the path to the .git directory" — not to the hook's cwd, which refused a repository
        # using git's own documented form.
        gitdir="$(git rev-parse --git-dir 2>/dev/null)" || gitdir=""
        case "$gitdir" in
            "") ;;
            /*) ;;
            # Relative to the CWD, which is where it was asked, exactly as in `common_of`.
            *) gitdir="$PWD/$gitdir" ;;
        esac
        case "$declared" in /*) ;; *) declared="$gitdir/$declared" ;; esac
        if [ -n "$gitdir" ] && [ -d "$declared" ] &&
           [ "$(cd "$declared" 2>/dev/null && pwd -P)" = "$(cd "$repo_root" 2>/dev/null && pwd -P)" ]
        then
            verdict=same
        fi
    fi
fi

# What the arm buys, stated precisely because half of it is missing: setup.sh runs, so the
# binary, the extension and the service are refreshed. Its HOOK section is not — measured,
# `install_git_hooks` reports `error=not a git repo` in this layout, because `_git` scrubs
# `GIT_DIR` and the tree has no `.git` of its own to discover from. That message is false and
# the installer needs its own answer to "which repository is this?"; it is filed rather than
# bolted on here, since the scrub it would have to relax is the one keeping jkb out of other
# people's repositories.

case "$verdict" in
    elsewhere)
        echo "jkb: this merge is about $hook_common, but the working tree here is $repo_root," >&2
        echo "jkb: which belongs to a different repository — GIT_DIR or GIT_WORK_TREE is set in" >&2
        echo "jkb: your environment. Skipping, rather than building somebody else's checkout." >&2
        exit 0 ;;
    # ITS OWN SENTENCE, because it is its own fact. Reported as "belongs to a different
    # repository", this refused the ordinary bare-dotfiles layout (a bare repo plus an exported
    # `GIT_WORK_TREE`) with a claim that is false of it and a remedy that would break it — the
    # rule this file states forty lines up and then broke.
    #
    # A skip and not a build, because within "unestablished" the legitimate dotfiles layout and
    # a leak into a directory no repository owns are INDISTINGUISHABLE from the repository's own
    # records: in both, the tree is solely the caller's word and the repository declares nothing.
    # There is no signal to separate them, and the wrong guess registers a service and spends two
    # minutes installing into a stranger's directory.
    #
    # What changes is the cost of being wrong: a true sentence that names a one-line remedy,
    # which routes the user into the arm's legitimate accept on their next pull, instead of a
    # false accusation that is silent and permanent. Any future environmental oddity that breaks
    # the scrubbed ask — a `safe.directory` refusal, a leaked `GIT_CEILING_DIRECTORIES` — now
    # degrades to this honest skip rather than to that accusation.
    unestablished)
        # The remedy is a COMMAND, so it is quoted like one. A repository path containing a
        # space — `~/Library/Application Support/...`, a Windows-ish share, any of a dozen
        # ordinary Mac locations — turned the printed line into `config core.worktree /a b`,
        # which git reads as a value plus a stray argument and rejects. A remedy that does not
        # parse is not a remedy, and this refusal's whole worth is that it names one.
        shq() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }
        echo "jkb: could not establish which repository the checkout at $repo_root belongs to:" >&2
        echo "jkb: it has no .git of its own, and the repository this merge is about does not" >&2
        echo "jkb: declare it. Skipping setup.sh rather than guessing. To enable jkb here, tell" >&2
        echo "jkb: the repository which tree is its own:" >&2
        # ...and if it declares a DIFFERENT tree, say which. The remedy below would silently
        # overwrite that declaration, and the difference between "not set up yet" and "set up,
        # pointing somewhere else" is exactly the difference between a chore and a leak. Without
        # this line the user confirms the leak by following the instructions.
        if [ -n "$declared_raw" ]; then
            echo "jkb: (it declares $declared_raw, which is not this tree — check that before" >&2
            echo "jkb:  overwriting it; the command below replaces that declaration.)" >&2
        fi
        # A BARE repository refuses `core.worktree` outright — "core.bare and core.worktree do
        # not make sense", then "fatal: unable to set up work tree using invalid config" — and
        # the bare-dotfiles layout is the exact layout this refusal is written for, so the one
        # remedy it named did not work anywhere it was most likely to be read. Measured on
        # 2.51.1: with `core.bare` cleared first, the declaration takes and the next pull is the
        # ordinary case. It is printed only when the repository IS bare, because telling anyone
        # else to unset a flag they never set is noise a remedy cannot afford.
        # Through `honoured_read`, for both reasons at once. A BARE `git config` read answers
        # from `-c`, `GIT_CONFIG_COUNT`, `--global` and the environment — the caller's channels,
        # every one — and this line decides what the operator is told to run. And the scope it
        # answers FROM is the scope the remedy has to be written to, or the command is inert.
        # `git init --bare` writes `bare = true` into `$GIT_DIR/config`, which is the layout
        # this is printed for; `config.worktree` can hold it instead, and then a local
        # `bare = false` changes nothing. case10l runs every printed line against both.
        honoured_read core.bare --bool
        if [ "$honoured_value" = true ]; then
            echo "jkb:   git --git-dir=$(shq "$hook_common") config ${honoured_scope:+$honoured_scope }core.bare false" >&2
        fi
        echo "jkb:   git --git-dir=$(shq "$hook_common") config ${declared_scope:+$declared_scope }core.worktree $(shq "$repo_root")" >&2
        # NOT "prefer that declaration to an exported GIT_WORK_TREE". That sentence named a
        # precondition which the scoped read removed: the alias may go on setting the work tree,
        # by flag or by variable, and the declaration is what jkb trusts either way. Measured —
        # both dotfiles spellings build on the next pull WITH THE ALIAS UNCHANGED.
        echo "jkb: (your alias may keep setting the work tree; the declaration is what jkb" >&2
        echo "jkb:  trusts, and it is the repository's own answer rather than the caller's.)" >&2
        # NOT `exit 0`, and NOT because the two chores differ in what they need — SUPERSEDED,
        # and the superseded claim is kept because it was confidently argued and measurably
        # wrong. It read: "chore 2 needs only the repository the merge was ABOUT, which is not
        # in doubt here: `$hook_common` named it, and `close-merged` scopes itself to the
        # repository it is run from."
        #
        # It scopes itself by DISCOVERING that repository from its cwd with `GIT_DIR`,
        # `GIT_WORK_TREE` and `GIT_COMMON_DIR` scrubbed — the same three this file strips in
        # `common_of`, and `--show-toplevel` needs strictly more than the `--git-common-dir`
        # ask that just failed. `$hook_common` knows the answer and has no way to say it: there
        # is no flag for it, and `--repo` is refused unless it equals a key close-merged could
        # already compute. MEASURED against the real binary in the bare-dotfiles layout:
        #
        #     error: not inside a git repo — a task session is a git worktree, so run this from the repo
        #
        # and exit 1, so the hook adds `jkb: close-merged failed (continuing)`. Two lines, both
        # false of this reader — they are not in a task session, and there is no other checkout
        # to run it from — printed directly beneath a refusal whose entire worth is that every
        # sentence in it is true.
        #
        # So the flags stay two, which is the part that was right: `same`-by-declaration runs
        # setup.sh and skips chore 2, and those are genuinely two answers. What they must not
        # share is a blanket `exit` — `elsewhere` keeps one, because there the cwd belongs to a
        # DIFFERENT repository, discovery SUCCEEDS, and close-merged would close tasks against
        # that repo's key, quietly.
        skip_setup=1 ;;
esac

# `post-merge` runs with $1 = 1 when the merge was a squash. ORIG_HEAD is the pre-merge tip
# either way, so it is the honest range for "what did this pull bring in".
range="ORIG_HEAD..HEAD"
git rev-parse --verify --quiet ORIG_HEAD >/dev/null 2>&1 || range="HEAD^..HEAD"
changed="$(git diff --name-only "$range" 2>/dev/null)"

# --- 1. setup.sh, only when it would actually change something -----------------------
# setup.sh installs the binary (crates/), the extension (ui/) and the service (scripts/).
# A pull touching only openspec/ or docs cannot affect any of them, and a full cargo
# install is ~1-2 minutes we should not spend on every pull.
if [ "${skip_setup:-0}" = 1 ]; then
    :   # already said why, above — and said it in one sentence rather than two verdicts' worth
elif [ -x "$repo_root/scripts/setup.sh" ] &&
   printf '%s\n' "$changed" | grep -qE '^(crates/|ui/|scripts/|Cargo\.(toml|lock)$)'; then
    echo "jkb: pulled changes touch crates/ ui/ or scripts/ — running setup.sh"
    "$repo_root/scripts/setup.sh" || echo "jkb: setup.sh failed (continuing; re-run by hand)"
else
    echo "jkb: no build-affecting changes pulled — skipping setup.sh"
fi

# --- 2. close tasks whose branch landed ----------------------------------------------
# Runs in every repo that installs this hook, not just jkb: `close-merged` scopes itself to
# the repo it is run from — by DISCOVERING it from the cwd with the caller's repository
# selection scrubbed, which is the one thing this hook already knows can fail here.
#
# `$skip_close` is that fact, computed once, sixty lines up: it is set on the branch where the
# scrubbed ask did not resolve, which covers both the honest refusal AND the `core.worktree`
# layout the arm accepts. In neither does close-merged have a repository to name; measured, it
# prints "not inside a git repo — a task session is a git worktree, so run this from the repo"
# and exits 1. Skipped WITH A LINE rather than silently, because in the accepted layout
# everything else about the pull looks ordinary and a chore quietly not happening is how the
# next round's defect gets built on top of it. The underlying gap — jkb's repository discovery
# cannot see a `core.worktree` checkout at all, which also makes `install_git_hooks` report
# `error=not a git repo` there — is filed, not papered over here: the scrub it would have to
# relax is the one keeping jkb out of other people's repositories.
if [ "${skip_close:-0}" = 1 ]; then
    echo "jkb: not closing merged tasks — jkb cannot work out which repository this tree is" >&2
elif command -v jkb >/dev/null 2>&1; then
    jkb task close-merged || echo "jkb: close-merged failed (continuing)"
fi

exit 0
