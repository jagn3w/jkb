#!/usr/bin/env bash
# Repo-local post-merge hook (design D34.5). Installed by scripts/setup.sh.
#
# Fires after any merge that changes the work tree — which is every `git pull` that brings
# something in. Two chores that were previously manual:
#
#   1. re-run setup.sh, so the installed `jkb` binary and the VS Code extension match what
#      was just pulled — but ONLY when the merge touched something setup.sh installs;
#   2. close tasks whose pull request has merged (`jkb task close-merged`).
#
# Never fails the merge. A hook that can break `git pull` is worse than the chore it
# replaces, so every step is best-effort and reports rather than exits non-zero.
set -uo pipefail

# A HOOK HONOURS THE ENVIRONMENT GIT HANDS IT, and every git call here is therefore bare.
#
# Git runs a hook with the cwd at the working tree it resolved. What it puts in the environment
# DEPENDS ON THE LAYOUT — measured on 2.51.1, all three:
#
#   ordinary checkout    GIT_DIR unset, GIT_WORK_TREE unset      (cwd alone is enough)
#   linked worktree      GIT_DIR=<repo>/.git/worktrees/<name>    (GIT_WORK_TREE unset)
#   GIT_WORK_TREE leaked GIT_DIR=<repo>/.git, GIT_WORK_TREE=.
#
# So `GIT_DIR` is not always set — but wherever it IS set it names the repository the merge was
# about, and in the third row it is the ONLY pointer to it. Stripping it there is not a safety
# measure, it is losing the subject. (An earlier version of this comment stated the third row
# as though it were all three: one layout measured, three asserted.) A previous round stripped it and MEASURED the
# result: `ORIG_HEAD` stopped resolving, the `HEAD^..HEAD` fallback answered about the wrong
# repository, `changed` came back empty, and a pull that changed `crates/` printed "no
# build-affecting changes pulled" — the exact failure the strip was written to prevent, caused
# by the strip.
#
# Stripping cannot help in any case either, which is the other half of why it is gone:
# `--show-toplevel` answers the redirected tree with the variables set OR unset (with `GIT_DIR`
# set and `GIT_WORK_TREE` unset, git regards the CWD as the work-tree top, and git already
# chdir'd there). So the redirection is detected below rather than fought.

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$repo_root" ] || exit 0

# ...and the one thing the environment CAN get wrong is which checkout to build. With
# `GIT_WORK_TREE` exported — the standard bare-dotfiles shell recipe — the merge is about this
# repository while `--show-toplevel` names an unrelated one, and running THAT checkout's
# setup.sh is the harm the whole repository-selection rule exists to prevent: jkb runs inside
# other people's professional repositories and must not build them.
#
# Asked of git, not of the variables: whether the checkout at $repo_root belongs to the
# repository this merge was about. Best-effort, like everything here: a question git will not
# answer stops the hook rather than failing the merge.
#
# `pwd -P` on both sides because a symlink, a trailing slash and a `..` are three spellings of
# one directory — the rule `git_hooks_dir` needed in lib.sh, where literal equality DID produce
# a false alarm. Stated honestly: it is DEFENSIVE here, not demonstrated. Five layouts were
# tried on Linux (plain, symlinked checkout, linked worktree, submodule, and a `.git` symlinked
# to a detached git dir) and removing it changed no answer in any of them, because git hands a
# hook an already-resolved `GIT_DIR`. It is kept for the platform this box cannot reproduce,
# where the temp or home path is itself a symlink (macOS `/tmp` -> `/private/tmp`).
# `--git-common-dir` rather than `--path-format=absolute --git-common-dir`. `--path-format` is
# a much later addition than `--git-common-dir` (not verified here to a version, which is why it
# is avoided rather than relied on): on a git without it rev-parse exits non-zero, the hook
# would `exit 0`, and the D34 automation would be silently off for that user.
#
# A relative answer is anchored at the directory it was ASKED FROM, never at the cwd — the two
# differ here by construction, which is the whole point of the comparison.
common_of() {   # common_of [dir] — [dir] asks with the environment scrubbed; no arg asks as git
    local d="${1:-}" c                    # handed us. Prints an absolute, symlink-resolved path.
    if [ -n "$d" ]; then
        c="$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
             git -C "$d" rev-parse --git-common-dir 2>/dev/null)" || return 1
    else
        d="$PWD"
        c="$(git rev-parse --git-common-dir 2>/dev/null)" || return 1
    fi
    [ -n "$c" ] || return 1
    case "$c" in /*) ;; *) c="$d/$c" ;; esac
    [ -d "$c" ] || return 1
    (cd "$c" 2>/dev/null && pwd -P)
}
hook_common="$(common_of "")" || exit 0
root_common="$(common_of "$repo_root")" || root_common=""
if [ "$hook_common" != "$root_common" ]; then
    echo "jkb: this merge is about $hook_common, but the working tree here is $repo_root," >&2
    echo "jkb: which belongs to a different repository — GIT_DIR or GIT_WORK_TREE is set in" >&2
    echo "jkb: your environment. Skipping, rather than building somebody else's checkout." >&2
    exit 0
fi

# `post-merge` runs with $1 = 1 when the merge was a squash. ORIG_HEAD is the pre-merge tip
# either way, so it is the honest range for "what did this pull bring in".
range="ORIG_HEAD..HEAD"
git rev-parse --verify --quiet ORIG_HEAD >/dev/null 2>&1 || range="HEAD^..HEAD"
changed="$(git diff --name-only "$range" 2>/dev/null)"

# --- 1. setup.sh, only when it would actually change something -----------------------
# setup.sh installs the binary (crates/), the extension (ui/) and the service (scripts/).
# A pull touching only openspec/ or docs cannot affect any of them, and a full cargo
# install is ~1-2 minutes we should not spend on every pull.
if [ -x "$repo_root/scripts/setup.sh" ] &&
   printf '%s\n' "$changed" | grep -qE '^(crates/|ui/|scripts/|Cargo\.(toml|lock)$)'; then
    echo "jkb: pulled changes touch crates/ ui/ or scripts/ — running setup.sh"
    "$repo_root/scripts/setup.sh" || echo "jkb: setup.sh failed (continuing; re-run by hand)"
else
    echo "jkb: no build-affecting changes pulled — skipping setup.sh"
fi

# --- 2. close tasks whose branch landed ----------------------------------------------
# Runs in every repo that installs this hook, not just jkb: `close-merged` scopes itself to
# the repo it is run from and needs nothing but git.
if command -v jkb >/dev/null 2>&1; then
    jkb task close-merged || echo "jkb: close-merged failed (continuing)"
fi

exit 0
