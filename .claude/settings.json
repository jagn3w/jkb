{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-raw-cargo.sh\"",
            "statusMessage": "Checking for raw cargo…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-raw-sqlite.sh\"",
            "statusMessage": "Checking for raw sqlite3…"
          }
        ]
      }
    ]
  }
}
